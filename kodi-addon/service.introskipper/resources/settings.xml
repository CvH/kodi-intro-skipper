<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<settings>
    <category label="30000"> <!-- Connection -->
        <setting label="30001" type="text" id="server_url" default="http://127.0.0.1:8037"/>
        <setting label="30003" type="slider" id="request_timeout" default="3" range="1,1,10" option="int"/>
    </category>

    <category label="30010"> <!-- Skip Behavior -->
        <setting label="30011" type="enum" id="intro_action" lvalues="30012|30013|30014" default="0"/>
        <setting label="30020" type="enum" id="credits_action" lvalues="30012|30013|30021|30014" default="0"/>
        <setting label="30022" type="slider" id="credits_prompt_duration" default="8" range="3,1,20" option="int" subsetting="true" visible="eq(-1,0)"/>
    </category>

    <category label="30030"> <!-- Path Mapping -->
        <setting label="30031" type="text" id="path_prefix_client" default=""/>
        <setting label="30033" type="text" id="path_prefix_server" default=""/>
    </category>

    <category label="30040"> <!-- Scan Management -->
        <setting label="30041" type="action" id="manage_sources_btn" action="RunScript(service.introskipper,manage_sources)"/>
        <setting label="30043" type="action" id="trigger_scan_btn" action="RunScript(service.introskipper,scan)"/>
        <setting label="30045" type="action" id="check_status_btn" action="RunScript(service.introskipper,status)"/>
        <setting label="30047" type="action" id="monitor_scan_btn" action="RunScript(service.introskipper,monitor)"/>
    </category>
</settings>
